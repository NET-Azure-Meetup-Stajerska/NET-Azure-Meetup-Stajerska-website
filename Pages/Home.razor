@page "/"
@using System.Globalization
@using MeetupWebsite.Data

<!-- Hero Section -->
<section class="hero-section py-5 mb-0">
	<div class="container">
		<div class="row justify-content-center text-center">
			<div class="col-lg-8">
				<h1 class="display-5 fw-bold mb-3">.NET &amp; Azure Meetup Štajerska</h1>
				<p class="lead mb-4">A community of developers, tech enthusiasts, and professionals passionate about .NET, Azure, and related technologies. Whether you're a seasoned expert or just starting out — you're welcome here!</p>
				<a href="https://discord.gg/K6F7pdP4xq" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-discord px-5 py-3">
					<i class="bi bi-discord me-2"></i>Join us on Discord
				</a>
			</div>
		</div>
	</div>
</section>

<!-- Upcoming Events Section -->
<div class="container py-5">
	<h2 class="h3 text-primary mb-4 border-bottom pb-2">Upcoming Events</h2>

	@if (upcomingEvents == null)
	{
		<div class="text-center py-4">
			<div class="loading-spinner mx-auto mb-3"></div>
			<p class="text-muted">Loading events...</p>
		</div>
	}
	else if (upcomingEvents.Count == 0)
	{
		<p class="text-muted">No upcoming events at the moment. Check back soon!</p>
	}
	else
	{
		@foreach (var (index, ev) in upcomingEvents)
		{
			<section class="mb-4">
				<div class="card">
					<div class="card-body p-4">
						<div class="row align-items-center gy-3">
							<div class="col-lg-8">
								<div class="d-flex flex-column flex-md-row align-items-center text-center text-md-start">
									<div class="date-badge text-white rounded-3 p-3 me-md-4 mb-3 mb-md-0 text-center">
										<div class="h4 mb-0 fw-bold">@ev.EventStartsAt.Day</div>
										<div class="small">@ev.EventStartsAt.ToString("MMM").ToUpper()</div>
									</div>
									<div>
										<h3 class="h5 mb-1">@ev.Name</h3>
										<p class="text-muted mb-2">
											<span class="d-block d-md-inline"><i class="bi bi-clock me-1"></i> @ev.EventStartsAt.ToString("HH:mm") - @ev.EventEndsAt.ToString("HH:mm")</span>
											<span class="d-block d-md-inline ms-md-3"><i class="bi bi-geo-alt me-1"></i>@ev.Location.Name</span>
										</p>
										<p class="text-muted small mb-0">@ev.Description</p>
									</div>
								</div>
							</div>
							<div class="col-lg-4 text-center text-lg-end">
								<a href="/events/@ev.Slug" class="btn btn-primary btn-lg px-4">
									<i class="bi bi-info-circle me-2"></i>View Details
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>
		}
	}

	<!-- Past Events Section -->
	@if (pastEvents != null && pastEvents.Count > 0)
	{
		<h2 class="h3 text-primary mt-5 mb-4 border-bottom pb-2">Past Events</h2>

		@foreach (var (index, ev) in pastEvents)
		{
			<section class="mb-4">
				<div class="card">
					<div class="card-body p-4">
						<div class="row align-items-center gy-3">
							<div class="col-lg-8">
								<div class="d-flex flex-column flex-md-row align-items-center text-center text-md-start">
									<div class="date-badge date-badge-past text-white rounded-3 p-3 me-md-4 mb-3 mb-md-0 text-center">
										<div class="h4 mb-0 fw-bold">@ev.EventStartsAt.Day</div>
										<div class="small">@ev.EventStartsAt.ToString("MMM").ToUpper()</div>
									</div>
									<div>
										<h3 class="h5 mb-1 text-secondary">@ev.Name</h3>
										<p class="text-muted mb-0">
											<span class="d-block d-md-inline"><i class="bi bi-clock me-1"></i> @ev.EventStartsAt.ToString("HH:mm") - @ev.EventEndsAt.ToString("HH:mm")</span>
											<span class="d-block d-md-inline ms-md-3"><i class="bi bi-geo-alt me-1"></i>@ev.Location.Name</span>
										</p>
									</div>
								</div>
							</div>
							<div class="col-lg-4 text-center text-lg-end">
								<a href="/events/@ev.Slug" class="btn btn-outline-secondary btn-lg px-4">
									<i class="bi bi-clock-history me-2"></i>View Details
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>
		}
	}
</div>
